# Apex LifeOS - Environment Configuration
# Copy this file to .env and fill in your Supabase credentials

# Supabase Project Configuration (From Project Settings > API)
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# Optional: Google Gemini API key for AI transaction parsing
# VITE_GEMINI_API_KEY=your-gemini-api-key
